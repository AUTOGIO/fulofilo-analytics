# FulôFiló Analytics Pro — .gitignore
# ──────────────────────────────────────

# ── Python ─────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
dist/

# ── Virtualenvs / package caches ───────
.venv/
venv/
.uv-cache/

# ── Test / tooling caches ──────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── Node (Cloudflare worker) ───────────
cf-worker/node_modules/
cf-worker/.wrangler/
node_modules/

# ── Bundled automations (local runtime) ─
automations/rede-automation/node_modules/
automations/rede-automation/.browser-profile/
automations/rede-automation/logs/
automations/rede-automation/.dashboard-launchers/
automations/loyverse-data/chrome-profile/
automations/loyverse-data/logs/
automations/loyverse-data/raw/*
!automations/loyverse-data/raw/.gitkeep
automations/loyverse-data/processed/*
!automations/loyverse-data/processed/.gitkeep

# ── Editors / IDEs ─────────────────────
.vscode/
.idea/
.cursor/
.claude/
*.swp
*.swo
*~

# ── OS noise ───────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ── Logs ───────────────────────────────
logs/
*.log
.n8n/

# ── Secrets / env ──────────────────────
.env
.env.*
!.env.example
!.env.*.example
scripts/launchagent/saleswatch.local.env
secrets/
*.pem
*.key

# ── Temporary / scratch ────────────────
tmp/
.tmp/
*.tmp
*.bak
*.orig

# ── Generated reports / exports ────────
excel/FuloFilo_Report_*.xlsx
excel/FuloFilo_Rehearsal_Report_*.xlsx
FuloFilo_Report_*.xlsx
FuloFilo_Rehearsal_Report_*.xlsx
data/processed/reports/FuloFilo_Report_*.xlsx
data/processed/reports/FuloFilo_Rehearsal_Report_*.xlsx
~$*.xlsx
reports/*.tmp.xlsx
sales_automation_bundle.zip

# ── DuckDB transients (keep the .duckdb file) ──
data/fulofilo.duckdb.wal

data/source_catalog/
data/raw_checkout/
data/synthetic/
data/splits/
data/outputs/
data/models/
data/backgrounds/
data/manifests/catalog_manifest.csv
data/manifests/catalog_manifest.json
data/manifests/scene_manifest.csv
data/manifests/split_manifest.csv
data/automation/

# ── Versioned read models (Streamlit Cloud reads these from git) ──
# data/parquet/*.parquet  — regenerated by scripts/sync_excel.sh
# data/fulofilo.duckdb    — optional bootstrap file; dashboard reads parquet views
# NOT ignored: data/excel/FuloFilo_Master.xlsx (source of truth, committed when changed)
# Ignored runtime artifact: data/excel/source_sync_status.json

# ── Codex / AI agent artifacts ─────────
.codex-predeploy-untracked-*/
.codex-*.png

# ── App bundles ────────────────────────
*.app/
macos/**/.build/
macos/**/.swiftpm/

# ── Excel backups (large, regenerable) ─
data/excel/backups/
data/excel/rehearsal/

# ── Voice memo / catalog raw data ──────
data/VoiceMemo_csv/
data/catalog/

# Runtime sync artifacts (regenerated on each sync)
data/excel/source_sync_status.json

# ── Explicitly tracked (do not ignore) ─
!AGENTS.md
!uv.lock
!docker-compose*.yml
!*.code-workspace
